# Ramp environment. Copy to .env (git-ignored) and fill in locally. Never commit real values.
# The API loads this file from the repo root; the web app reads API_BASE_URL from its own environment.

# Nebius Token Factory API key for NVIDIA Nemotron calls (secret, API only).
NEBIUS_API_KEY=
# Nebius Token Factory OpenAI-compatible base URL.
NEBIUS_BASE_URL=
# Nemotron model id used to write code changes.
NEMOTRON_TEXT_MODEL=
# Nemotron vision model id used to write image alt text.
NEMOTRON_VISION_MODEL=
# Tavily API key for page discovery and WCAG guidance links (secret, API only).
TAVILY_API_KEY=
# GitHub token used to clone, push, and open the pull request (secret, API only).
GITHUB_TOKEN=
# Comma-separated GitHub owners Ramp may clone or push to; default swayamasarawala.
ALLOWED_GITHUB_OWNERS=
# Comma-separated browser origins allowed by API CORS; default http://localhost:3000.
CORS_ORIGINS=
# API URL the web app's server calls (never sent to the browser); default http://localhost:8000.
API_BASE_URL=
